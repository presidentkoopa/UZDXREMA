/*
** gpuparticles.vp
**
** [GPUPARTICLES] Stateless particles: a record holds starting conditions and
** this shader works out where the particle is NOW. Nothing is simulated per
** frame. See "Engine docs/GPU_PARTICLES_PLAN.md" and hw_gpuparticlebuffer.h.
**
** Vulkan only. The record buffer (GpuParticleSSO, set 1 binding 5) is declared
** in vk_shader.cpp's prolog; GL and GLES never load this effect.
**
** Record, shader space (y is up), 80 bytes:
**   a  xyz spawn position                 w  birth, level seconds
**   b  xyz initial velocity, units/s      w  life, seconds (0 = free slot)
**   c  rgb colour 0..1                    w  intensity
**   d  x size start  y size end (diameter, map units)  z gravity u/s^2  w drag 1/s
**   e  x orient mode  y stretch (seconds of travel drawn as trail)  zw phase 2
**
**---------------------------------------------------------------------------
**
** Copyright 2026 UZDXREMA
**
** SPDX-License-Identifier: GPL-3.0-or-later
**
**---------------------------------------------------------------------------
*/

// Slot index low/high 16 bits, corner 0..5, unused. C++ calls this location
// VATTR_BONESELECTOR; it is the only integer attribute the engine has.
layout(location = 8) in uvec4 aParticle;

layout(location = 0) out vec2 vParticleCorner;
layout(location = 1) out vec4 vParticleColor;

const vec2 kParticleCorners[6] = vec2[6](
	vec2(-1.0, -1.0), vec2( 1.0, -1.0), vec2( 1.0,  1.0),
	vec2(-1.0, -1.0), vec2( 1.0,  1.0), vec2(-1.0,  1.0));

// A particle outside its life puts all six vertices on one point outside the
// clip volume: zero-area triangles never rasterise, so a dead slot costs six
// vertex invocations and nothing else.
void CollapseParticle()
{
	gl_Position = vec4(2.0, 2.0, 2.0, 1.0);
	vParticleCorner = vec2(0.0);
	vParticleColor = vec4(0.0);
}

void main()
{
#ifdef SUPPORTS_MULTIVIEW
	hwViewIndex = gl_ViewIndex;
#endif

	uint slot = aParticle.x | (aParticle.y << 16u);
	int corner = int(aParticle.z) % 6;
	GpuParticle part = gpuParticles[slot];

	float life = part.b.w;
	float age = uLevelTime.x - part.a.w;
	if (life <= 0.0 || age < 0.0 || age > life)
	{
		CollapseParticle();
		return;
	}

	float t = age / life;
	float diameter = min(mix(part.d.x, part.d.y, t) * uGpuParticleParams.x, uGpuParticleParams.y);
	if (diameter <= 0.0)
	{
		CollapseParticle();
		return;
	}
	float halfSize = 0.5 * diameter;

	// Closed-form motion with linear drag. k is clamped so drag 0 needs no
	// branch: (1 - e^-ka)/k tends to a as k tends to 0.
	float k = max(part.d.w, 1e-4);
	float decay = exp(-k * age);
	vec3 up = vec3(0.0, 1.0, 0.0);
	vec3 pos = part.a.xyz + part.b.xyz * ((1.0 - decay) / k) - up * (part.d.z * 0.5 * age * age);
	vec3 vel = part.b.xyz * decay - up * (part.d.z * age);

	vec2 c = kParticleCorners[corner];
	int orient = int(part.e.x + 0.5);
	vec4 eyePos;

	if (orient == 2)
	{
		// WORLD-FLAT: a quad whose normal is the initial velocity direction, so
		// a flake faces the way it was thrown.
		vec3 n = part.b.xyz;
		float nl = length(n);
		n = (nl > 1e-5) ? n / nl : up;
		vec3 seedAxis = (abs(n.y) < 0.9) ? up : vec3(1.0, 0.0, 0.0);
		vec3 tx = normalize(cross(seedAxis, n));
		vec3 ty = cross(n, tx);
		eyePos = ViewMatrix * vec4(pos + (tx * c.x + ty * c.y) * halfSize, 1.0);
	}
	else
	{
		// CAMERA-FACING, offset in eye space. Each eye has its own view matrix,
		// so stereo is correct, and any scale/mirror baked into the view matrix
		// is already applied to the centre.
		eyePos = ViewMatrix * vec4(pos, 1.0);
		vec2 offs = c * halfSize;

		if (orient == 1)
		{
			// VELOCITY-STRETCHED: the long axis follows the velocity projected
			// onto the view plane, so a spark flying at the eye stays short.
			vec3 ve = mat3(ViewMatrix) * vel;
			float sl = length(ve.xy);
			if (sl > 1e-3)
			{
				vec2 along = ve.xy / sl;
				vec2 across = vec2(-along.y, along.x);
				float halfLen = halfSize + sl * part.e.y * uGpuParticleParams.z;
				offs = along * (c.x * halfLen) + across * (c.y * halfSize);
			}
		}
		eyePos.xy += offs;
	}

	gl_Position = ProjectionMatrix * eyePos;

#ifdef VULKAN_COORDINATE_SYSTEM
	gl_Position.z = (gl_Position.z + gl_Position.w) / 2.0;
#endif

	float fade = 1.0 - smoothstep(0.6, 1.0, t);
	vParticleColor = vec4(part.c.rgb * (part.c.w * uGpuParticleParams.w * fade), 1.0);
	vParticleCorner = c;
}

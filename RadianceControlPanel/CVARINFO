// GlowInTheDark -- ZScript rebuild.
// Names match the original's intent, not its spelling: the 2021 cvarinfo
// used color_redd / color_greenn / color_bluee for the floor set.

server bool gitd_enabled     = true;   // master switch
server int  gitd_height      = 64;     // how far the glow reaches, in map units. The original declared this and never used it.
server bool gitd_skip_liquid = true;   // leave liquid-terrain planes alone entirely

// Where a room's colour comes from. Replaces the old gitd_fixed bool.
//   0 = random per room (what the 2021 original did)
//   1 = the one fixed colour set below
//   2 = the average of the flat's own pixels, via TexMan.GetAverageColor
server int gitd_colour_source = 0;

// Who outranks whom. These drive the engine's glow-authority API directly:
// Sector.SetGlowColorAuto / SetGlowColor / IsGlowAuthored / GetTextureGlow.
server bool gitd_respect_textures = true;   // paint as a fallback, so GLDEFS Glow{Flats{}} colours survive
server bool gitd_respect_mapper   = true;   // never paint over glow the map itself authored
server bool gitd_unify_reach      = false;  // keep a texture's own colour but stretch it to gitd_height

server int gitd_ceiling_r = 135;
server int gitd_ceiling_g = 135;
server int gitd_ceiling_b = 135;

server int gitd_floor_r = 135;
server int gitd_floor_g = 135;
server int gitd_floor_b = 135;



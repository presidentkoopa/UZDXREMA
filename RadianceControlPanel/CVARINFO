// ---------------------------------------------------------------------------
// Glowing wall textures and edge glow on floors -- ALSO NOTHING TO DECLARE.
//
// Same rule, same reason. Both effects run inside the renderer, so the engine
// owns their cvars:
//
//   gl_texture_wallglow, gl_texture_wallglow_intensity
//       hw_walls.cpp -- honours the GLDEFS Glow { Walls { } } block
//
//   gl_flatglow, _floor, _ceiling, _reach, _intensity, _shape, _sharpness,
//   _inset, _bandwidth, _spacing, _edges, _color, _colormode, _cap,
//   _pulse, _pulse_depth
//       hw_flats.cpp -- edge glow, sixteen knobs, master switch off by default
//
// MENUDEF reaches all of them by name. There is no gitd_* mirror and there
// should not be one: two cvars for one setting is how they drift apart.
// ---------------------------------------------------------------------------
